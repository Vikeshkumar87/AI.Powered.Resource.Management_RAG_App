# Application Settings
APP_NAME=AI Resource Management RAG App
APP_VERSION=1.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite:///./resource_management.db

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=resource_management

# LLM Configuration
# Provider options: openai | ollama | demo
LLM_PROVIDER=ollama

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding Model
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Demo Authentication
AUTH_SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Administrator
USER_USERNAME=user
USER_PASSWORD=user123
USER_DISPLAY_NAME=User

# Frontend Integration
BACKEND_URL=http://localhost:8000
FAISS_INDEX_PATH=./faiss_store/employee_index

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:8080", "http://localhost:5173", "http://127.0.0.1:5173"]

# Logging
LOG_LEVEL=INFO
